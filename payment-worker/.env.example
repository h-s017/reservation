# Non-secret Worker vars documented in HANA_EVENT.md. For local Wrangler, put secrets in .dev.vars.
EVENT_MODE=disabled
EVENT_SITE_ORIGIN=
EVENT_PUBLIC_ORIGIN=
PORTALY_API_HOST=https://portaly.ai
PORTALY_EVENT_PLAN_ID=
PORTALY_PHYSICAL_EVENT_APPROVED=false
PORTALY_API_KEY=
PORTALY_CALLBACK_SECRET=
